    "id": "func_aggregate_room",
    "type": "function",
    "z": "tab_sensors",
    "name": "Label by Node ID",
    "func": "const parts = msg.topic.split('/');\nconst nodeId = parts[0];\nmsg.topic = 'Stick ' + nodeId;\nmsg.payload = parseFloat(msg.payload);\nreturn msg;",
