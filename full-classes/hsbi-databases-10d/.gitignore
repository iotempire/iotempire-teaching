# Local run artifacts — never commit these.

# Python
__pycache__/
*.py[cod]
.venv/
.python-version

# Databases and data files (a reviewer must be able to rebuild them from scripts)
*.db
*.db-journal
*.sqlite
*.sqlite3
*.duckdb
*.parquet

# Generated slide PDFs (rebuild with slides/render-slides.sh)
/slides/*.pdf

# Instructor scratch: smoke-test.sh extracts the module's own code here
/scratch/

# Secrets
.env

# Editors / OS
.DS_Store
